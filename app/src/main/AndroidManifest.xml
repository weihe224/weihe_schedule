<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Class reminders. Asked for at runtime from the settings screen, not at
        launch; a denial is shown there rather than hidden.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Exact alarms. A class reminder has to arrive at a particular minute, so the
        scheduler asks for setExactAndAllowWhileIdle and falls back to the inexact
        call only when this permission is missing. From Android 12 the permission is
        user-grantable and can be revoked again, which is why ReminderScheduler
        checks canScheduleExactAlarms() before every registration instead of
        assuming the declaration is enough.

        SCHEDULE_EXACT_ALARM, not USE_EXACT_ALARM: the latter is auto-granted but
        reserved for alarm clocks and calendars, and this app is neither. One
        permission, asked for once, with the system's own settings page as the entry
        point.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
        Needed to be told that the device has finished booting. A reboot clears
        every alarm in the system, so without this the reminder plan would simply
        be gone until the app was next opened. Ordinary permission, granted at
        install; no runtime prompt.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeiheSchedule">
        <activity
            android:name=".EditCourseActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SemesterListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AboutActivity"
            android:exported="false" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EditScheduleActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ScheduleListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CourseSearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".BackupPreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CourseDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".WeekGridActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Not exported and with no intent filter: the only thing that ever sends
            this broadcast is the app's own AlarmManager alarm, addressed to this
            component by class. Nothing outside the app can make a reminder appear.
        -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />
        <!--
            Rebuilds the plan when something outside the app invalidates it. Every
            action below is on the platform's list of broadcasts a manifest-declared
            receiver may still get after Android 8.0's background limits:

              BOOT_COMPLETED        a reboot clears every alarm there is
              TIME_SET              the clock moved, so every instant moved with it
              TIMEZONE_CHANGED      the same, through the zone the instants were made in
              MY_PACKAGE_REPLACED   sent only to this app, so not implicit at all
              SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED
                                    exact alarms were just granted or revoked, so the
                                    whole plan has to be registered through the new
                                    route; this is the event that upgrades a plan from
                                    "may be late" to "on the minute" while the app is
                                    closed

            ACTION_DATE_CHANGED is deliberately absent: it is NOT on that list, so a
            receiver here would never be called. Midnight rollover is already covered,
            because each alarm that fires re-plans and every screen syncs on resume.

            exported="false" is the tighter setting, not a restriction that would
            mute it: the platform documents that a non-exported receiver still
            receives system broadcasts, and all of the actions above are protected
            broadcasts no other app could send anyway.
        -->
        <receiver
            android:name=".reminder.ReminderRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            The home-screen widget.

            exported="false" like every other receiver here: the platform still
            delivers APPWIDGET_UPDATE to it, and no other app should be able to make
            it redraw. The second action is the app's own boundary alarm (class over,
            next class starting, day rolling over), which is what keeps the widget
            truthful while the app is closed; the periodic update the platform
            offers is half an hour coarse.

            The label is what the widget picker lists; the description explains what
            the widget is for before it is placed.
        -->
        <receiver
            android:name=".widget.CourseWidgetProvider"
            android:exported="false"
            android:label="@string/widget_course_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.weihe.schedule.action.WIDGET_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/course_widget_info" />
        </receiver>

        <!--
            The 1x2 widget: one class, at a glance.

            A separate provider rather than a second entry in the existing one: a
            widget's size range is declared per provider, so one provider cannot offer
            both a 3x2 layout and a 1x2 one. Two entries in the picker is also the
            honest description of what the app now offers.

            It receives no broadcasts of its own. The boundary alarm and every data
            change go through CourseWidgetUpdater, which redraws every widget on the
            device whichever size it is.
        -->
        <receiver
            android:name=".widget.NextClassWidgetProvider"
            android:exported="false"
            android:label="@string/widget_next_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_class_widget_info" />
        </receiver>

        <!--
            The 2x2 widget: the class that matters now, plus the one after it.

            A third provider for the third size, for the same reason as the second: a
            provider declares one size range. It receives no broadcasts of its own;
            CourseWidgetUpdater redraws every size from one timetable read.
        -->
        <receiver
            android:name=".widget.SquareWidgetProvider"
            android:exported="false"
            android:label="@string/widget_square_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/square_widget_info" />
        </receiver>
    </application>
</manifest>
