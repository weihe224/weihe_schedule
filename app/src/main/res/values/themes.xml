<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Keep every item here duplicated in values-v27/themes.xml.

      A style split across values/ and values-v27/ is not merged: the resource
      system picks the best match and uses that definition alone. Worse, the
      parent cannot be omitted to "inherit", because AAPT reads the name
      Theme.WeiheSchedule as an implicit parent of style/Theme and fails to
      link. So each file carries the complete definition, and the v27 one adds
      windowLightNavigationBar on top.
    -->
    <style name="Theme.WeiheSchedule" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/surface</item>
        <!-- Every screen enters and leaves the same way; see animations.xml. -->
        <item name="android:windowAnimationStyle">@style/PageAnimation</item>

        <!--
          The header is the page surface now, so the status bar carries the page
          colour and keeps dark icons. That is the whole of the "seamless" trick
          here: with the window still fitting system windows, a transparent
          status bar would simply show the window background as a strip above the
          header. Real edge-to-edge needs
          WindowCompat.setDecorFitsSystemWindows, which lives in androidx.core
          and cannot be added here (see ARCHITECTURE.md).
        -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Dark system icons: the bar behind them is the light page surface. -->
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:navigationBarColor">@color/navigation_bar</item>
    </style>
</resources>
