<?xml version="1.0" encoding="utf-8"?>
<!--
    The 2x1 widget: one class on a single wide strip.

    Two cells wide and one tall is roughly 180x96dp. That is the opposite shape to the
    column this started as, so the information lies down: status and countdown on the
    first line, the name and the start time on the second, the room on a third that is
    hidden when the launcher reports a box too short for it.

    The card, the tinted block inside it, the 3dp colour rail and the type scale are
    the same ones the 3x2 widget uses, so the two sizes read as one family rather than
    as two designs that happen to sit on the same home screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_headline_bg"
        android:orientation="horizontal"
        android:padding="@dimen/widget_block_padding">

        <ImageView
            android:id="@+id/widget_next_rail"
            android:layout_width="@dimen/widget_accent_width"
            android:layout_height="match_parent"
            android:background="@color/widget_headline"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_next_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_next_status_default"
                    android:textColor="@color/widget_ink_muted"
                    android:textSize="@dimen/widget_text_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_next_countdown_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/widget_ink_muted"
                    android:textSize="@dimen/widget_text_title"
                    android:visibility="gone" />

                <Chronometer
                    android:id="@+id/widget_next_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:countDown="true"
                    android:textColor="@color/widget_ink"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_next_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_default_name"
                    android:textColor="@color/widget_ink"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_next_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_next_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink_muted"
                android:textSize="@dimen/widget_text_detail" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
