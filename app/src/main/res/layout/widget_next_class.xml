<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding_compact">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_next_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_default_title"
            android:textColor="@color/widget_ink_muted"
            android:textSize="@dimen/widget_text_header"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:breakStrategy="balanced" />
        <TextView
            android:id="@+id/widget_next_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/widget_pill_padding_h"
            android:paddingTop="@dimen/widget_pill_padding_v"
            android:paddingEnd="@dimen/widget_pill_padding_h"
            android:paddingBottom="@dimen/widget_pill_padding_v"
            android:textColor="@color/widget_accent"
            android:textSize="@dimen/widget_text_pill"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:breakStrategy="balanced" />
    </LinearLayout>
    <!-- Keep the remaining-height frame separate from the natural-height row:
         merging them stretches the colour rail instead of centring the course. -->
    <FrameLayout
        tools:ignore="UselessParent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical">
            <ImageView
                android:id="@+id/widget_next_bar"
                android:layout_width="@dimen/widget_bar"
                android:layout_height="match_parent"
                android:background="@color/widget_accent"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_bar_inset"
                android:layout_weight="1"
                android:gravity="top"
                android:orientation="vertical"
                tools:ignore="NestedWeights">
                <TextView
                    android:id="@+id/widget_next_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_default_name"
                    android:textColor="@color/widget_ink"
                    android:textSize="@dimen/widget_text_title_compact"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:breakStrategy="balanced" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="true">
                    <TextView
                        android:id="@+id/widget_next_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/widget_ink_muted"
                        android:textSize="@dimen/widget_text_time_compact"
                        android:includeFontPadding="false"
                        android:breakStrategy="balanced" />
                    <TextView
                        android:id="@+id/widget_next_room"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_ink_faint"
                        android:textSize="@dimen/widget_text_meta"
                        android:includeFontPadding="false"
                        android:breakStrategy="balanced"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/widget_gap"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
