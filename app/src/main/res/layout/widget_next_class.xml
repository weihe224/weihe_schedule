<?xml version="1.0" encoding="utf-8"?>
<!--
    The 2x1 widget: the next class, as large as a single strip allows.

    The top row is exactly the 3x2's header: the date on the left, the teaching week as
    a quiet capsule on the right, so the three sizes read as one family. The rest is the
    4dp bar and three lines: name, start time, room. The bar starts at the class itself,
    because it marks the course and not the header.

    No countdown and no status word: the strip answers "which class, and when", and which
    class it is already implies whether it is running. The name and the time never
    truncate; the room is the one line allowed an ellipsis.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding_compact">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_default_title"
            android:textColor="@color/widget_ink_muted"
            android:textSize="@dimen/widget_text_header"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/widget_pill_padding_h"
            android:paddingTop="@dimen/widget_pill_padding_v"
            android:paddingEnd="@dimen/widget_pill_padding_h"
            android:paddingBottom="@dimen/widget_pill_padding_v"
            android:textColor="@color/widget_accent"
            android:textSize="@dimen/widget_text_pill"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_next_bar"
            android:layout_width="@dimen/widget_bar"
            android:layout_height="match_parent"
            android:background="@color/widget_accent"
            android:contentDescription="@null" />

        <!-- The outer weight spends the strip's spare height; the inner one centres the
             three lines inside it, which is worth the second level. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/widget_bar_inset"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="vertical"
            tools:ignore="NestedWeights">

            <TextView
                android:id="@+id/widget_next_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_default_name"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_title_compact"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/widget_ink_muted"
                android:textSize="@dimen/widget_text_time_compact" />

            <TextView
                android:id="@+id/widget_next_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink_faint"
                android:textSize="@dimen/widget_text_meta" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
