<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/scrolling_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="@dimen/widget_padding_compact">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/scrolling_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_default_title" android:textColor="@color/widget_ink_muted" android:textSize="@dimen/widget_text_header" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/scrolling_week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_pill_bg" android:paddingStart="@dimen/widget_pill_padding_h" android:paddingTop="@dimen/widget_pill_padding_v" android:paddingEnd="@dimen/widget_pill_padding_h" android:paddingBottom="@dimen/widget_pill_padding_v" android:textColor="@color/widget_accent" android:textSize="@dimen/widget_text_pill" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ListView android:id="@+id/scrolling_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:scrollbars="vertical" />
    <TextView android:id="@+id/scrolling_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/widget_text_meta" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>