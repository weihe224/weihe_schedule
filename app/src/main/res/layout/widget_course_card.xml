<?xml version="1.0" encoding="utf-8"?>
<!--
    One class card.

    Two lines, on purpose: the widget has to fit two of these plus the entry even
    when the system font is scaled up, and a third line is what pushes the second
    card out of the widget. The name may be ellipsized; the second line carries the
    time and where it happens.

    Added to the widget as a nested RemoteViews (up to twice), so both cards can share
    this one id set without one binding the other's views.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/widget_card_gap"
    android:background="@drawable/widget_headline_bg"
    android:orientation="horizontal"
    android:padding="@dimen/widget_block_padding">

    <ImageView
        android:id="@+id/widget_card_accent"
        android:layout_width="@dimen/widget_accent_width"
        android:layout_height="match_parent"
        android:background="@color/widget_headline"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_card_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_default_name"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_name"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_card_countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_ink_muted"
                android:textSize="@dimen/widget_text_title"
                android:visibility="gone" />

            <Chronometer
                android:id="@+id/widget_card_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:countDown="true"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_name"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_card_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_default_detail"
            android:textColor="@color/widget_ink_muted"
            android:textSize="@dimen/widget_text_detail" />
    </LinearLayout>
</LinearLayout>
