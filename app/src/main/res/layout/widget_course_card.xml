<?xml version="1.0" encoding="utf-8"?>
<!--
    One class in the 3x2 list.

    Three lines, in the order a person reads a timetable: what, when, where with whom.
    The 4dp bar on the left is the course's own colour, the same one the detail screen
    marks it with, so a row here can be matched to a row in the app.

    The time is tabular (tnum): two rows of times must line up digit for digit, which
    proportional digits never quite do. There is no countdown on the item: the bar plus
    the words "已结束" say all a list row can usefully say about state.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingTop="@dimen/widget_item_padding"
        android:paddingBottom="@dimen/widget_item_padding">

        <ImageView
            android:id="@+id/widget_card_bar"
            android:layout_width="@dimen/widget_bar"
            android:layout_height="match_parent"
            android:background="@color/widget_accent"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_bar_inset"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_card_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_default_name"
                    android:textColor="@color/widget_ink"
                    android:textSize="@dimen/widget_text_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_card_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/widget_ended"
                    android:textSize="@dimen/widget_text_status"
                    android:visibility="gone" />


            </LinearLayout>

            <TextView
                android:id="@+id/widget_card_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/widget_ink_muted"
                android:textSize="@dimen/widget_text_time" />

            <TextView
                android:id="@+id/widget_card_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink_faint"
                android:textSize="@dimen/widget_text_meta" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_card_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_divider_height"
        android:background="@color/widget_divider"
        android:contentDescription="@null" />
</LinearLayout>
