<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:id="@+id/widget_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal" android:paddingTop="@dimen/widget_item_padding" android:paddingBottom="@dimen/widget_item_padding" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_card_bar" android:layout_width="@dimen/widget_bar" android:layout_height="match_parent" android:background="@color/widget_accent" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/widget_bar_inset" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/widget_card_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_default_name" android:textColor="@color/widget_ink" android:textSize="@dimen/widget_text_title" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/widget_card_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_ended" android:textSize="@dimen/widget_text_status" android:visibility="gone" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="true">
                <TextView android:id="@+id/widget_card_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFeatureSettings="tnum" android:textColor="@color/widget_ink_muted" android:textSize="@dimen/widget_text_time" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/widget_card_teacher" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/widget_gap" android:gravity="end" android:includeFontPadding="false" android:textSize="@dimen/widget_text_meta" android:textColor="@color/widget_ink_muted" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/widget_card_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_ink_faint" android:textSize="@dimen/widget_text_meta" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_card_divider" android:layout_width="match_parent" android:layout_height="@dimen/widget_divider_height" android:background="@color/widget_divider" android:contentDescription="@null" android:layout_gravity="bottom" />
</FrameLayout>