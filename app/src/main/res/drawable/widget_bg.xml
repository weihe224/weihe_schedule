<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's own surface: the same white card the app's screens use, with the
     same hairline, so a widget and a card read as the same object. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="@dimen/widget_corner" />
    <stroke
        android:width="@dimen/widget_stroke"
        android:color="@color/widget_outline" />
</shape>
