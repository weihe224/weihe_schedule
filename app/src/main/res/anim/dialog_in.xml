<?xml version="1.0" encoding="utf-8"?>
<!--
  Dialog entrance: a short fade with a slight scale-up, so the panel settles
  rather than appears. Scale is a percentage of the panel, so it reads the same
  on a one-line message and on a form.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <scale
        android:fromXScale="0.92"
        android:toXScale="1.0"
        android:fromYScale="0.92"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="180" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="150" />
</set>
