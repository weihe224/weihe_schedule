<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive launcher icon.

  Every layer is a raster mipmap rather than a vector because the artwork is a
  soft-shaded illustration, which vector paths cannot carry. All of them are
  generated by tools/IconForge.java from the supplied source image, which is also
  what keeps the five densities identical to each other.

  The folder has no -v26 qualifier: adaptive icons need API 26 and minSdk is 26, so
  the qualifier would say nothing that is not already guaranteed.

  The foreground is already scaled into the central safe circle, so no launcher
  mask can clip the drawing. The backdrop is a soft sage a step darker than the
  calendar's own cream, so the artwork still separates from its background at
  launcher sizes. The monochrome layer is the same drawing reduced to one colour,
  for the themed icons Android 13 and later tint from the wallpaper.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
