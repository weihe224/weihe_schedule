<?xml version="1.0" encoding="utf-8"?>
<!--
  The round adaptive launcher icon. Same three layers as ic_launcher.xml: a round
  launcher mask is applied to this shape by the system, so the layers must be the
  same 108dp canvases rather than a pre-rounded image. Pre-rounding them here
  would double-round the corners inside a circular mask.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
