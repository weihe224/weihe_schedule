<?xml version='1.0' encoding='utf-8'?>
<!-- Cell targets control modern launchers. Keep legacy and resize minima low
     enough that a stricter launcher does not promote the requested row count.
     These values describe placement, not a promise that arbitrary text fits. -->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_course_description"
    android:initialLayout="@layout/widget_course"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="180dp"
    android:minWidth="180dp"
    android:previewLayout="@layout/widget_course"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
