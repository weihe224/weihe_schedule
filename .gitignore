# Build output
build/
.gradle/
# Local Gradle distribution + user home used when the real one is unwritable
.gradle-local/
# Local Android user home: holds the debug keystore used when ~/.android is not
# writable, plus emulator state. Nothing here belongs in version control.
.android-home/

# Android Studio / IntelliJ local state
.idea/
*.iml
captures/

# Local machine configuration -- never commit this, it holds the SDK path
local.properties

# Native build output
.externalNativeBuild/
.cxx/

# Output of the tools/ generators: the mask contact sheet IconForge writes for
# eyeballing the launcher icon, and the screenshots/UI dumps taken while
# checking a build on a device. Both are reproducible from icon.png.
tools/preview/
tools/shots/
tools/out/

# Packaged artifacts
*.apk
*.aab
*.ap_
*.dex

# OS noise
.DS_Store
Thumbs.db
